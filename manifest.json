{
  "manifest_version": 3,
  "name": "Penknife",
  "version": "0.1.0",
  "description": "Small tools for Basecamp: keyboard navigation for docs, and export to PDF or Markdown.",
  "homepage_url": "https://github.com/alexbache/penknife",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://*.basecamp.com/*"],
      "js": [
        "src/lib/html-to-markdown.js",
        "src/core.js",
        "src/basecamp.js",
        "src/tools/doc-nav.js",
        "src/tools/doc-export.js",
        "src/main.js"
      ],
      "css": ["src/penknife.css"],
      "run_at": "document_idle"
    }
  ]
}
